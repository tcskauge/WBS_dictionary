Option Explicit

Public Sub LagWBS()

    Dim lo As ListObject, wsScan As Worksheet
    Dim wsLayout As Worksheet, wsOld As Worksheet
    
    Dim nodes As Object
    Dim children As Object
    
    Dim r As ListRow
    Dim info As clsNode
    
    Dim indent As Double: indent = 30
    Dim vertikalAvstand As Double: vertikalAvstand = 15
    Dim linjeTykkelse As Double: linjeTykkelse = 6
    
    Dim boksBredde As Double: boksBredde = 220
    Dim boksHoyde As Double: boksHoyde = boksBredde / 1.618
    
    Dim fixedTopLevel0 As Double: fixedTopLevel0 = 80
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    ' Finn første tabell
    For Each wsScan In ThisWorkbook.Worksheets
        If wsScan.ListObjects.Count > 0 Then
            Set lo = wsScan.ListObjects(1)
            Exit For
        End If
    Next wsScan
    If lo Is Nothing Then Exit Sub
    
    ' Slett gammelt ark
    On Error Resume Next
    Set wsOld = Worksheets("WBS_Layout")
    If Not wsOld Is Nothing Then wsOld.Delete
    On Error GoTo 0
    
    Set wsLayout = Worksheets.Add
    wsLayout.Name = "WBS_Layout"
    
    Set nodes = CreateObject("Scripting.Dictionary")
    Set children = CreateObject("Scripting.Dictionary")
    
    ' =============================
    ' Bygg struktur
    ' =============================
    
    For Each r In lo.ListRows
        
        Set info = New clsNode
        
        info.ID = CStr(r.Range.Cells(1, 2).Value)
        info.Level = CLng(r.Range.Cells(1, 1).Value)
        info.parentID = GetParentWBS(info.ID)
        info.Caption = CStr(r.Range.Cells(1, 3).Value)
        info.FillColor = r.Range.Cells(1, 1).Interior.Color
        
        nodes.Add info.ID, info
        
        If Not children.Exists(info.parentID) Then
            children.Add info.parentID, New Collection
        End If
        
        children(info.parentID).Add info.ID
        
    Next r
    
    ' =============================
    ' Plasser nivå 0
    ' =============================
    
    nodes("0").TopPos = fixedTopLevel0
    nodes("0").LeftPos = 100
    
    ' =============================
    ' Plasser nivå 1 horisontalt
    ' =============================
    
    Dim currentLeft As Double
    currentLeft = 100
    
    Dim childID As Variant
    
    If children.Exists("0") Then
        
        For Each childID In children("0")
            
            nodes(childID).TopPos = _
                nodes("0").TopPos + boksHoyde + vertikalAvstand
            
            nodes(childID).LeftPos = currentLeft
            
            currentLeft = currentLeft + boksBredde + 4 * indent
            
        Next childID
        
    End If
    
    ' =============================
    ' Plasser nivå =2 lokalt per gren
    ' =============================
    
    If children.Exists("0") Then
        
        For Each childID In children("0")
            PlaceSubtree CStr(childID), nodes, children, _
                         boksHoyde, vertikalAvstand, indent
        Next childID
        
    End If
    
    ' =============================
    ' Tegn
    ' =============================
    
    Dim nodeID As Variant
    Dim shp As Shape
    
    For Each nodeID In nodes.Keys
        
        Set shp = wsLayout.Shapes.AddShape( _
                    msoShapeRoundedRectangle, _
                    nodes(nodeID).LeftPos, _
                    nodes(nodeID).TopPos, _
                    boksBredde, _
                    boksHoyde)
        
        With shp
            .TextFrame2.TextRange.Text = _
                nodes(nodeID).ID & vbCrLf & nodes(nodeID).Caption
            
            .TextFrame2.TextRange.Font.Size = 20
            .TextFrame2.TextRange.ParagraphFormat.Alignment = msoAlignCenter
            .TextFrame2.VerticalAnchor = msoAnchorMiddle
            
            If nodes(nodeID).Level < 2 Then
                .TextFrame2.TextRange.Font.Fill.ForeColor.RGB = RGB(255, 255, 255)
            Else
                .TextFrame2.TextRange.Font.Fill.ForeColor.RGB = RGB(0, 0, 0)
            End If
            
            .Fill.ForeColor.RGB = nodes(nodeID).FillColor
            .Line.Weight = linjeTykkelse
        End With
        
    Next nodeID
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

End Sub

Private Sub PlaceSubtree( _
    ByVal parentID As String, _
    ByRef nodes As Object, _
    ByRef children As Object, _
    ByVal boksHoyde As Double, _
    ByVal vertikalAvstand As Double, _
    ByVal indent As Double _
)

    Dim currentTop As Double
    Dim childID As Variant
    
    If Not children.Exists(parentID) Then Exit Sub
    
    currentTop = nodes(parentID).TopPos + boksHoyde
    
    For Each childID In children(parentID)
        
        currentTop = currentTop + vertikalAvstand
        
        nodes(childID).TopPos = currentTop
        nodes(childID).LeftPos = nodes(parentID).LeftPos + indent
        
        ' Rekursivt videre ned
        PlaceSubtree CStr(childID), nodes, children, _
                     boksHoyde, vertikalAvstand, indent
        
        ' Flytt currentTop til etter hele child-subtreet
        currentTop = GetSubtreeBottom(CStr(childID), nodes, children, _
                                      boksHoyde, vertikalAvstand)
        
    Next childID

End Sub

Private Function GetSubtreeBottom( _
    ByVal nodeID As String, _
    ByRef nodes As Object, _
    ByRef children As Object, _
    ByVal boksHoyde As Double, _
    ByVal vertikalAvstand As Double _
) As Double

    Dim bottom As Double
    Dim childID As Variant
    
    bottom = nodes(nodeID).TopPos + boksHoyde
    
    If children.Exists(nodeID) Then
        For Each childID In children(nodeID)
            bottom = GetSubtreeBottom(CStr(childID), _
                                      nodes, children, _
                                      boksHoyde, vertikalAvstand)
        Next childID
    End If
    
    GetSubtreeBottom = bottom '+ vertikalAvstand

End Function

Private Function GetParentWBS(ByVal wbs As String) As String
    
    Dim pos As Long
    pos = InStrRev(wbs, ".")
    
    If pos > 0 Then
        GetParentWBS = Left$(wbs, pos - 1)
    Else
        If wbs = "0" Then
            GetParentWBS = ""
        Else
            GetParentWBS = "0"
        End If
    End If
    
End Function
