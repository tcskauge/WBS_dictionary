Option Explicit

Public Sub LagWBS()

    Dim lo As ListObject, wsScan As Worksheet
    Dim wsLayout As Worksheet, wsOld As Worksheet
    
    Dim nodes As Object
    Dim children As Object
    
    Dim r As ListRow
    Dim info As clsNode
    
    Dim wbsID As String
    Dim parentID As String
    Dim nodeLevel As Long
    
    Dim indent As Double: indent = 15
    Dim vertikalAvstand As Double: vertikalAvstand = 15
    Dim linjeTykkelse As Double: linjeTykkelse = 6
    Dim A3bredde As Double: A3bredde = 1580
    
    Dim antallNivaa1 As Long
    Dim boksBredde As Double
    Dim boksHoyde As Double
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    ' Finn første tabell
    For Each wsScan In ThisWorkbook.Worksheets
        If wsScan.ListObjects.Count > 0 Then
            Set lo = wsScan.ListObjects(1)
            Exit For
        End If
    Next wsScan
    
    If lo Is Nothing Then Exit Sub
    
    ' Slett gammelt ark
    On Error Resume Next
    Set wsOld = Worksheets("WBS_Layout")
    If Not wsOld Is Nothing Then wsOld.Delete
    On Error GoTo 0
    
    Set wsLayout = Worksheets.Add
    wsLayout.Name = "WBS_Layout"
    
    Set nodes = CreateObject("Scripting.Dictionary")
    Set children = CreateObject("Scripting.Dictionary")
    
    ' Tell nivå 1
    For Each r In lo.ListRows
        If CLng(r.Range.Cells(1, 1).Value) = 1 Then
            antallNivaa1 = antallNivaa1 + 1
        End If
    Next r
    
    If antallNivaa1 = 0 Then Exit Sub
    
    boksBredde = (A3bredde - 3 * indent) / (antallNivaa1 + 1)
    boksHoyde = boksBredde / 1.618
    
    ' Bygg node-struktur
    For Each r In lo.ListRows
        
        wbsID = CStr(r.Range.Cells(1, 2).Value)
        Debug.Print wbsID
        nodeLevel = CLng(r.Range.Cells(1, 1).Value)
        parentID = GetParentWBS(wbsID)
        
        Set info = New clsNode
        info.ID = wbsID
        info.parentID = parentID
        info.Level = nodeLevel
        info.SubtreeHeight = boksHoyde
        info.Caption = CStr(r.Range.Cells(1, 3).Value)
        info.FillColor = r.Range.Cells(1, 1).Interior.Color
        
        nodes.Add wbsID, info
        
        If Not children.Exists(parentID) Then
            Dim col As Collection
            Set col = New Collection
            children.Add parentID, col
        End If
        
        children(parentID).Add wbsID
        
    Next r
    
    Dim k As Variant
For Each k In children.Keys
    Debug.Print "Parent:", k
Next k
    
    ' Beregn subtree-høyder
    CalculateSubtreeHeight "0", nodes, children, boksHoyde, vertikalAvstand
    
    ' Plasser noder
    PlaceNode "0", 300, 80, nodes, children, _
              boksBredde, boksHoyde, indent, vertikalAvstand, _
              wsLayout, linjeTykkelse
    
    ' Tegn koblinger
    'DrawConnectors nodes, wsLayout, linjeTykkelse
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

End Sub


' ==========================================
' SUBTREE HØYDE
' ==========================================

Private Function CalculateSubtreeHeight( _
    ByVal nodeID As String, _
    ByRef nodes As Object, _
    ByRef children As Object, _
    ByVal boksHoyde As Double, _
    ByVal vertikalAvstand As Double _
) As Double

    Dim totalHeight As Double
    Dim childID As Variant
    Dim childHeight As Double
    Dim firstChild As Boolean
    
    ' Hvis ingen barn ? høyde = egen høyde
    If Not children.Exists(nodeID) Then
        nodes(nodeID).SubtreeHeight = boksHoyde
        CalculateSubtreeHeight = boksHoyde
        Exit Function
    End If
    
    totalHeight = 0
    firstChild = True
    
    For Each childID In children(nodeID)
        
        childHeight = CalculateSubtreeHeight( _
                          CStr(childID), _
                          nodes, children, _
                          boksHoyde, vertikalAvstand)
        
        ' Legg til spacing mellom barn (ikke før første)
        If Not firstChild Then
            totalHeight = totalHeight + vertikalAvstand
        End If
        
        totalHeight = totalHeight + childHeight
        firstChild = False
        
    Next childID
    
    ' Hvis total subtree er mindre enn egen boks ? bruk egen høyde
    If totalHeight < boksHoyde Then
        totalHeight = boksHoyde
    End If
    
    nodes(nodeID).SubtreeHeight = totalHeight
    CalculateSubtreeHeight = totalHeight

End Function


' ==========================================
' PLASSERING
' ==========================================

Private Sub PlaceNode( _
    ByVal nodeID As String, _
    ByVal leftPos As Double, _
    ByVal topPos As Double, _
    ByRef nodes As Object, _
    ByRef children As Object, _
    ByVal boksBredde As Double, _
    ByVal boksHoyde As Double, _
    ByVal indent As Double, _
    ByVal vertikalAvstand As Double, _
    ByRef ws As Worksheet, _
    ByVal linjeTykkelse As Double _
)

    Dim shp As Shape
    Dim childID As Variant
    Dim currentTop As Double
    Dim currentLeft As Double
    Dim spacing As Double
    
    ' Lag boksen
    Set shp = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
                                 leftPos, topPos, _
                                 boksBredde, boksHoyde)
    
    With shp
        
        .TextFrame2.TextRange.Text = _
            nodes(nodeID).ID & vbCrLf & nodes(nodeID).Caption
        
        ' Fontstørrelse
        .TextFrame2.TextRange.Font.Size = 20
        
        ' Tekstfarge
        If nodes(nodeID).Level < 2 Then
            .TextFrame2.TextRange.Font.Fill.ForeColor.RGB = RGB(255, 255, 255)  ' Hvit
        Else
            .TextFrame2.TextRange.Font.Fill.ForeColor.RGB = RGB(0, 0, 0)        ' Sort
        End If
        
        ' Midtstilling
        .TextFrame2.TextRange.ParagraphFormat.Alignment = msoAlignCenter
        .TextFrame2.VerticalAnchor = msoAnchorMiddle
        .TextFrame2.AutoSize = msoAutoSizeNone
        
        ' Fyll og ramme
        .Fill.ForeColor.RGB = nodes(nodeID).FillColor
        .Fill.Solid
        .Line.Weight = linjeTykkelse
    
    End With
    
    Set nodes(nodeID).ShapeObj = shp
    
    If Not children.Exists(nodeID) Then Exit Sub
    
    ' ==========================================
    ' Nivå 1 ? horisontal plassering
    ' ==========================================
    
    If nodeID = "0" Then
        
        spacing = 4 * indent
        currentLeft = 100
        
        For Each childID In children(nodeID)
            
            PlaceNode CStr(childID), _
                      currentLeft, _
                      topPos + boksHoyde + vertikalAvstand, _
                      nodes, children, _
                      boksBredde, boksHoyde, _
                      indent, vertikalAvstand, _
                      ws, linjeTykkelse
                      
            currentLeft = currentLeft + boksBredde + spacing
            
        Next childID
    Else
    
        Dim childHeight As Double
        Dim firstChild As Boolean
        firstChild = True
        
        currentTop = topPos + boksHoyde + vertikalAvstand
        
        For Each childID In children(nodeID)
            
            childHeight = nodes(CStr(childID)).SubtreeHeight
            
            PlaceNode CStr(childID), _
                      leftPos + indent, _
                      currentTop, _
                      nodes, children, _
                      boksBredde, boksHoyde, _
                      indent, vertikalAvstand, _
                      ws, linjeTykkelse
            
            ' Øk currentTop kun med subtreeHeight
            currentTop = currentTop + childHeight
            
            ' Legg spacing bare hvis det finnes flere barn igjen
            If childID <> children(nodeID)(children(nodeID).Count) Then
                currentTop = currentTop + vertikalAvstand
            End If
            
        Next childID
    
    End If
End Sub


' ==========================================
' KOBLINGER
' ==========================================

Private Sub DrawConnectors( _
    ByRef nodes As Object, _
    ByRef ws As Worksheet, _
    ByVal linjeTykkelse As Double _
)

    Dim nodeID As Variant
    Dim parentID As String
    Dim conn As Shape
    
    For Each nodeID In nodes.Keys
        
        parentID = nodes(nodeID).parentID
        
        If parentID <> "" And nodes.Exists(parentID) Then
            
            Set conn = ws.Shapes.AddConnector(msoConnectorElbow, 0, 0, 0, 0)
            
            If nodes(nodeID).Level = 1 Then
                ' 0 ? 1
                conn.ConnectorFormat.BeginConnect nodes(parentID).ShapeObj, 4
                conn.ConnectorFormat.EndConnect nodes(nodeID).ShapeObj, 2
            Else
                ' øvrige nivå
                conn.ConnectorFormat.BeginConnect nodes(parentID).ShapeObj, 1
                conn.ConnectorFormat.EndConnect nodes(nodeID).ShapeObj, 1
            End If
            
            conn.Line.Weight = linjeTykkelse
            conn.RerouteConnections
            
        End If
        
    Next nodeID

End Sub


' ==========================================
' FINN PARENT
' ==========================================

Private Function GetParentWBS(ByVal wbs As String) As String

    Dim pos As Long
    pos = InStrRev(wbs, ".")
    
    If pos > 0 Then
        GetParentWBS = Left$(wbs, pos - 1)
    Else
        If wbs = "0" Then
            GetParentWBS = ""
        Else
            GetParentWBS = "0"
        End If
    End If

End Function


